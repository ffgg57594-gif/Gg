# Upstream chat function (the POST endpoint from your script)
UPSTREAM_URL=https://qcpujeurnkbvwlvmylyx.supabase.co/functions/v1/chat

# Optional key for the upstream chat function. The gateway does NOT forward
# Presenton's API key to the upstream (a BYOK proxy rejects a present-but-invalid
# Authorization with 400 "Invalid request format"). Only set this if the upstream
# genuinely requires a Bearer key that differs from what Presenton sends.
# UPSTREAM_API_KEY=

# Model Presenton will see under GET /v1/models
DEFAULT_MODEL=google/gemini-2.5-pro

# Comma-separated extra model ids (optional)
# MODELS=google/gemini-2.5-pro,google/gemini-2.5-flash

# If set, Presenton must use this as the API key (Authorization: Bearer ...)
# PROXY_API_KEY=

PORT=3000
